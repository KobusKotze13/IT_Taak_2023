unit Signup_u;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls ;

type
  TfrmSignup = class(TForm)
    gplSignup: TGridPanel;
    edtNewAgentPassword: TEdit;
    edtNewAgentName: TEdit;
    lblSignup: TLabel;
    pnlSignupbtn: TPanel;
    edtNewAgentNUmber: TEdit;
    edtNewAgentEmail: TEdit;
    lblNewAgentEmail: TLabel;
    lblNewAgentNumber: TLabel;
    lblNewAgentPassword: TLabel;
    lblNewAgentName: TLabel;
    edtNewAgentAddress: TEdit;
    lblNewAgentAddress: TLabel;

    procedure FormClose(Sender: TObject; var Action: TCloseAction);

    procedure pnlSignupbtnClick(Sender: TObject);

    procedure FormCreate(Sender: TObject);

    function CreateAgentID(Name, Number: String): String;

    procedure FormShow(Sender: TObject);

  private
    { Private declarations }
  public
    { Public declarations }
  end;

  // External functions to validate inputs (imported from Validation.dll)
  function IsValidNumber(const Number: string): Boolean; external 'Validation.dll'
  function IsValidPassword(const Password: string): Boolean; external 'Validation.dll'
  function IsValidEmail(const Email: string): Boolean; external 'Validation.dll'
  function IsValidName(Const Name: String): Boolean; external 'Validation.dll'

var
  frmSignup: TfrmSignup;

implementation
uses
Login_u;


{$R *.dfm}

// Function to create a unique Agent ID
function TfrmSignup.CreateAgentID(Name, Number: String): String;
var
  NewAgentID: String;
  SpacePos: integer;
begin
  SpacePos := Pos(' ', Name);
  NewAgentID := Copy(Name, 1, SpacePos - 1) + Copy(Name, SpacePos + 1, 1) + Copy(Number, 1, 2);
  Result := NewAgentID;
end;

// Event handler for when the form is closed
procedure TfrmSignup.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  frmLogin.show;
end;

// Event handler for when the form is created
procedure TfrmSignup.FormCreate(Sender: TObject);
begin
  frmLogin.connectDB;
end;

// Event handler for when the form is shown
procedure TfrmSignup.FormShow(Sender: TObject);
begin
  WindowState := TWindowState.wsMaximized;
end;

// Event handler for the Signup button
procedure TfrmSignup.pnlSignupbtnClick(Sender: TObject);
var
  TempPass: string;
  NewAgentID, FirstName, Surname, CellNumber: String;
  SpacePos: integer;
  UserAdded: boolean;
begin
  UserAdded := False;

  // Validate the password
  if IsValidPassword(edtNewAgentPassword.Text) = False then
  begin
    ShowMessage('Password must contain at least 8 characters and 1 special character');
    Exit;
  end;

  // Validate the phone number
  if IsValidNumber(edtNewAgentNumber.Text) = False then
  begin
    ShowMessage('Invalid Phone Number');
    Exit;
  end;

  // Validate the email address
  if IsValidEmail(edtNewAgentEmail.Text) = False then
  begin
    ShowMessage('Invalid Email');
    Exit;
  end;

  // Prompt for password confirmation
  TempPass := InputBox('Confirm Password', 'Enter Password', '');

  // If the passwords match, proceed with user creation
  if edtNewAgentPassword.Text = TempPass then
  begin
    // Remove any existing initial setup record
    tblAgent.First;
    tblAgent.Edit;
    while NOT tblAgent.Eof do
    begin
      if tblAgent['Agent_ID'] = '0000' then
      begin
        tblAgent.Delete;
      end;
      tblAgent.Next;
    end;

    // Add a new user record
    tblAgent.Append;
    tblAgent['Agent_ID'] := CreateAgentID(edtNewAgentName.Text, edtNewAgentNumber.Text);
    tblAgent['Agent_Name'] := edtNewAgentName.Text;
    tblAgent['Password'] := edtNewAgentPassword.Text;
    tblAgent['Cell_Number'] := edtNewAgentNumber.Text;
    tblAgent['Email'] := edtNewAgentEmail.Text;
    tblAgent['Address'] := edtNewAgentAddress.Text;
    tblAgent['Manager'] := True;
    tblAgent.Post;
    UserAdded := True;
  end;

  // Show a message indicating success or failure
  if UserAdded = True then
  begin
    ShowMessage('User Successfully Added');
    Sleep(300);
    frmSignup.Close;
  end;
end;

end.

