unit Main_Menu_u;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls;

type
  TfrmMainMenu = class(TForm)
    gplStaff: TGridPanel;
    pnlAddHouseBtn: TPanel;
    scbHouses: TScrollBox;
    pnlViewHousesBtn: TPanel;
    pnlManageAgentsBtn: TPanel;
    pnlAddAgentBtn: TPanel;
    pnlAddHouse: TPanel;
    pnlViewHouses: TPanel;
    pnlManageAgents: TPanel;
    pnlAddAgent: TPanel;
    btnLogoutMM: TButton;
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormShow(Sender: TObject);
    procedure btnLogoutMMClick(Sender: TObject);
    procedure pnlAddHouseBtnClick(Sender: TObject);
    procedure pnlViewHousesBtnClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmMainMenu: TfrmMainMenu;

implementation
uses
Login_u, Add_House_u, Add_Agent_u;

{$R *.dfm}

procedure TfrmMainMenu.btnLogoutMMClick(Sender: TObject);
begin
frmMainMenu.Hide;
frmLogin.Show;
end;

procedure TfrmMainMenu.FormClose(Sender: TObject; var Action: TCloseAction);
begin
frmLogin.show;
end;

procedure TfrmMainMenu.FormShow(Sender: TObject);
begin
frmMainMenu.WindowState := TWindowState.wsMaximized;
end;

procedure TfrmMainMenu.pnlAddHouseBtnClick(Sender: TObject);
begin
frmAddHouse.Show;
end;

procedure TfrmMainMenu.pnlViewHousesBtnClick(Sender: TObject);
begin
showmessage('Balls');
end;

end.
