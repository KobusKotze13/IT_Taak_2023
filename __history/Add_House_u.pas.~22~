unit Add_House_u;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, Vcl.ComCtrls,
  Vcl.Samples.Spin;

type
  TfrmAddHouse = class(TForm)
    gplPOS: TGridPanel;
    pnlAddHouseBtn: TPanel;
    pnlMainMenubtn: TPanel;
    lblErfSize: TLabel;
    lblBathrooms: TLabel;
    lblBedrooms: TLabel;
    lblAddress: TLabel;
    edtAddress: TEdit;
    memDiscription: TMemo;
    sedBedrooms: TSpinEdit;
    imgHouses: TImage;
    sedBathrooms: TSpinEdit;
    sedErfSize: TSpinEdit;
    lblHouseSize: TLabel;
    sedHouseSize: TSpinEdit;
    Label1: TLabel;
    edtPrice: TEdit;
    Panel1: TPanel;
    lblGarage: TLabel;
    SpinEdit1: TSpinEdit;

    procedure FormShow(Sender: TObject);

    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure pnlMainMenubtnClick(Sender: TObject);

  private
    { Private declarations }
  var
   

  public
    { Public declarations }
  end;

var
  frmAddHouse: TfrmAddHouse;

implementation

uses
  Login_u, Main_Menu_u;

{$R *.dfm}



// Event handler for when the form is closed
procedure TfrmAddHouse.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  frmLogin.Show;
end;

// Event handler for when the form is shown
procedure TfrmAddHouse.FormShow(Sender: TObject);
begin
frmAddHouse.WindowState := TWindowState.wsMaximized;
end;


procedure TfrmAddHouse.pnlMainMenubtnClick(Sender: TObject);
begin
frmMainMenu.show;
frmAddHouse.Hide;
end;

end.

